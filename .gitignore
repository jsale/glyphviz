__pycache__/
*.pyc
*.pyo

# Session archives / scratch notes — not part of the project
chat_archives/
vscode_claude_session_archive_*.txt

# Test/scratch CSV fixtures created during development
*_test.csv
verify*.csv
repro_test*.csv

# Third-party reference material — not ours to publish
gaiaviz-skill/

# Hyperglyph Lab: bulk-generated design output (the CSV/JSON per design is
# disposable/regeneratable; ratings.csv — the design journal — stays tracked)
hyperglyph_lab/output/

# PyInstaller build output
build/
dist/

# Linux release artifact (~164 MB), built by the GitHub Actions workflow and
# downloaded here when testing the browser-GUI container: Dockerfile.linux's
# `COPY . .` picks it up out of the working tree, so it has to sit at the repo
# root, but it's a build output like anything in dist/ and must never land in
# git history.
GlyphViz.AppImage

# Throwaway venv build_mac.sh creates on macOS
.venv-build/

# setuptools editable/metadata output (pip install -e .)
*.egg-info/
.eggs/

# tools/release.py fallback output folder, used only when the local iluvdata
# mirror isn't present (normally the release zips are written straight into
# that mirror, outside the repo).
release/

# Build wrapper: bakes in the local conda env path, which differs across
# Jeff's machines (anaconda3\envs vs .conda\envs) -- keep it local-only so a
# stale hardcoded path from one machine never lands on another via git.
# GlyphViz.spec (the actual build config) stays tracked; it derives the
# conda path from sys.prefix instead. See build.bat.example to recreate it.
build.bat

# Jupyter autosave checkpoints
.ipynb_checkpoints/

# Editor/OS cruft
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
.claude/

# GTDB example: the two big scenes ship zipped (Event_Cloud.zip /
# Org_Event_Network.zip); the unzipped working copies stay local-only.
# Regenerate everything with examples/Global_Terrorism_Example/generate_gtdb_examples.py
examples/Global_Terrorism_Example/Event_Cloud/
examples/Global_Terrorism_Example/Org_Event_Network/

# Tropical cyclone example: same deal — the two big scenes ship zipped
# (Global_Tracks.zip / Seasonal_Pulse.zip, 42 MB -> 5.6 MB); the unzipped
# working copies stay local-only. Poleward_Drift is small enough to commit
# as a folder. Regenerate everything with
# examples/Tropical_Cyclone_Example/build_cyclone_scenes.py
examples/Tropical_Cyclone_Example/Global_Tracks/
examples/Tropical_Cyclone_Example/Seasonal_Pulse/
# The Burn Record (San Diego County fire history): the same — the 17 MB
# scene ships as Burn_Record.zip; regenerate the folder (and the zip) with
# examples/San_Diego_Fire_History_Example/build_fire_history_scene.py
examples/San_Diego_Fire_History_Example/Burn_Record/
# Building GlyphViz: the same — the 6 MB scene ships as Building_GlyphViz_Scene.zip.
# It is built outside the repo (session_lab/, untracked: its private build holds
# unscrubbed paths) with build_corpus_scene.py --public, then copied here.
examples/Building_GlyphViz_Example/building_glyphviz_gv_node.csv
# Its public Make_Your_Own/ kit writes data/ and out/ beside itself when run;
# those hold whoever ran it's own transcripts, so they never ship.
examples/Building_GlyphViz_Example/Make_Your_Own/data/
examples/Building_GlyphViz_Example/Make_Your_Own/out/
# ...and never commit the ~330 MB raw archive that --download fetches; the
# 3.9 MB data/ibtracs_tidy.csv.gz snapshot beside it is what rebuilds offline.
examples/Tropical_Cyclone_Example/data/ibtracs.ALL.raw.csv

# Commercial music recordings — not licensed for public redistribution.
# The examples that use them commit all *generated* files; supply the WAV
# yourself (see each example's README) to enable synced audio playback.
cat_scan_all_mono.wav
mobygo1_mono.wav
# Top-level media/ is the working WAV pool for generate_audio_example.py;
# per-example media/ folders hold the distributable copies.
examples/Audio_Animation_Example/media/*.wav

# Local zip built for Claude Desktop skill upload; regenerate from the folder
glyphviz-skill/*.zip

# TUT demo archives: the zips ship (522 KB / 482 KB, and a zip is the form an
# X archive arrives in anyway); the unpacked 3.4 + 4.2 MB tweets.js stay local.
# Rebuild either with twitter_lab/v2_to_archive.py — see the folder's README.
twitter_lab/demo_archives/TUT_demo_*/

# Lesson-video renders (MP4/WAV/stills/TTS cache) -- regenerate with video_lessons/render_lesson.py
video_lessons/out/

# MLB Batting History: the 25 MB scene ships in the example's zip (4 MB);
# regenerate it with examples/MLB_Batting_History_Example/lahman_batting_to_glyphviz.py
examples/MLB_Batting_History_Example/MLB_Batting_History_gv_node.csv

# blender_lab: the x3 repeat of the preview video, and the regenerable render sequences
# (python blender_lab/gv_frames.py ... re-renders the 360 frames in ~15 s; Blender previews via blender_preview.py)
blender_lab/out/video/clockwork_x3.mp4
blender_lab/out/frames/seq/
blender_lab/out/blender_frames/

# Lorenz Synchronization lab (HCS demo): the 22 MB scene ships as Lorenz_Sync.zip (3.6 MB);
# regenerate the folder with lorenz_sync_lab/generate_lorenz_sync.py
lorenz_sync_lab/Lorenz_Sync/

# 5-D Lorenz feedback lab (Shen 2014): both scenes regenerate in ~20 s each with
# lorenz5d_feedback_lab/generate_convection_cells.py and generate_r_sweep_tower.py
lorenz5d_feedback_lab/Convection_Cells/
lorenz5d_feedback_lab/R_Sweep_Tower/
lorenz5d_feedback_lab/Feedback_Loop/
lorenz5d_feedback_lab/Stability_Landscape/

# Tensor lab: the scenes regenerate in seconds with tensor_lab/generate_*.py
# and ship as Tensors_*.zip (tensor_lab/zip_scenes.py)
tensor_lab/Vectors_and_Bases/
tensor_lab/Vector_to_Tensor/
tensor_lab/Spinning_Book/
tensor_lab/Current_Across_the_Grain/
tensor_lab/Slanted_Rulers/
tensor_lab/The_Cut/
tensor_lab/A_Field_of_Machines/

# String labs: the scenes regenerate in seconds with the generate_*.py scripts;
# 10d_superstring_lab/data/ is downloaded by landscape_data.py
bosonic_string_lab/Leech_Kissing/
bosonic_string_lab/String_Tower/
10d_superstring_lab/Superstring_Landscape/
10d_superstring_lab/data/
